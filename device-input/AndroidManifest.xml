<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.vanta.deviceinput" android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="35"/>
    <application android:label="Vanta Device Input" android:allowBackup="false">
        <service android:name=".VantaKeyboard" android:exported="true"
            android:label="Vanta Device Input"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod"/>
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method"/>
        </service>
        <receiver android:name=".TextReceiver" android:exported="true"
            android:permission="android.permission.DUMP"/>
    </application>
</manifest>
